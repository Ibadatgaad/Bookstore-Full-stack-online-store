# Copy this file to .env and adjust as needed

# Local MongoDB connection (make sure `mongod` is running locally)
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# Port for the Express API server
PORT=5000

# Secret used to sign JWTs — change this to any long random string
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
